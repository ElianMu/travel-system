# 配置优先级：环境变量 > .env.{APP_ENV} > .env > 代码默认值
# 生产环境的密钥请通过环境变量注入，不要写入文件
APP_ENV=dev
LOG_LEVEL=INFO
# 设为 true 时把 OpenTelemetry Span 输出到控制台
OTEL_CONSOLE_EXPORT=false

# 大模型（OpenAI 兼容协议）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Tavily 联网搜索
TAVILY_API_KEY=

# 内部知识库（本地向量检索）
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_PATH=./models/models--BAAI--bge-base-zh-v1.5/snapshots/f03589ceff5aac7111bd60cfc7d497ca17ecac65
KNOWLEDGE_BASE_DIR=./knowledge_base
# 向量索引所在目录，或以 .npz 结尾的文件路径
VECTOR_STORE_DIR=./storage

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3300
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=travel_kb
MYSQL_CHARSET=utf8mb4

# 检索
RETRIEVE_TOP_K=5
# 本地相似度低于该值时视为召回不足，转联网搜索
RETRIEVE_MIN_SCORE=0.55
