# 大模型（OpenAI 兼容协议）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Tavily 联网搜索
TAVILY_API_KEY=

# 内部知识库（本地向量检索）
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_PATH=./models/models--BAAI--bge-base-zh-v1.5/snapshots/f03589ceff5aac7111bd60cfc7d497ca17ecac65
KNOWLEDGE_BASE_DIR=./knowledge_base
# 注意：chromadb 1.5.x 的 Rust 后端无法把 HNSW 索引(.bin)写入含中文的路径，
# 而本项目位于含中文的目录，故用绝对 ASCII 路径规避。
VECTOR_STORE_DIR=

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3300
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=travel_kb
MYSQL_CHARSET=utf8mb4

# 检索
RETRIEVE_TOP_K=5
